# ─── Apoquiz Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Core ─────────────────────────────────────────────────────────────────────

# Backend port (default: 3002)
PORT=3002

# Database — SQLite for local, PostgreSQL for cloud
# Local:  DATABASE_URL=file:./data/apoquiz.db
# Cloud:  DATABASE_URL=postgresql://user:password@host:5432/apoquiz
DATABASE_URL=file:./data/apoquiz.db

# Node environment
NODE_ENV=production

# ─── Security ─────────────────────────────────────────────────────────────────

# Express session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Default admin password (overridden by data/config.json once changed in Settings)
ADMIN_PASSWORD=admin1234

# Default moderator PIN (overridden by data/config.json once changed in Settings)
MODERATOR_PIN=1234

# API key that the local instance sends when syncing to this cloud server.
# Generate with: openssl rand -hex 24
# Set the same value as CLOUD_API_KEY on the local instance.
SYNC_API_KEY=change-me-to-a-long-random-string

# ─── Cloud / Internet play ────────────────────────────────────────────────────

# Public-facing URL of this server (used for QR codes, CORS, and join URLs).
# Leave empty for local/LAN mode.
# Example: https://quiz.yourdomain.com
PUBLIC_URL=

# When syncing FROM a local instance TO cloud, set these on the local machine:
# CLOUD_URL=https://quiz.yourdomain.com
# CLOUD_API_KEY=<same value as SYNC_API_KEY on the cloud server>
CLOUD_URL=
CLOUD_API_KEY=
# git remote add origin https://github.com/afmdevelopers/apoquiz.git
# git branch -M main
# git push -u origin main